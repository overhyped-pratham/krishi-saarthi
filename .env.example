# ==============================================================================
# KRISHI SAARTHI / AGRI-INTELLIGENCE — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime environment ('production' serves compiled frontend SPA from /dist)
NODE_ENV=production

# Application listening port (Google Cloud Run / Render automatically injects this)
PORT=3000

# Server bind address
HOST=0.0.0.0

# Cloud Run deployment metadata (optional, populated automatically in Cloud Run)
K_SERVICE=krishi-saarthi-backend
K_REVISION=krishi-saarthi-backend-00001-prod
CLOUD_RUN_REGION=asia-south1

# ------------------------------------------------------------------------------
# 2. GOOGLE AI & GEMINI SERVICES (CRITICAL)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Krishi Saarthi AI chatbot, multilingual advisory,
# disease diagnosis explanations, and multi-turn voice interaction.
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. SMS & WHATSAPP ADVISORY ALERTS (TWILIO) (OPTIONAL)
# ------------------------------------------------------------------------------
# Required for dispatching SMS/WhatsApp agro-advisories and disease alert notifications to farmers.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 4. SATELLITE & GOOGLE EARTH ENGINE (GEE) (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Cloud / Earth Engine credentials for Sentinel-2 NDVI/NDMI/EVI fetching.
GEE_PROJECT_ID=krishi-saarthi-gee
GEE_SERVICE_ACCOUNT=krishi-saarthi-gee@your-project-id.iam.gserviceaccount.com
GEE_KEY_FILE=/app/credentials/gee-key.json

# ------------------------------------------------------------------------------
# 5. FRONTEND (VITE) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# In unified single-container deployment (Cloud Run, Docker), leave VITE_API_URL empty
# so Vite makes relative requests (e.g. /api/...) to the same domain.
# If deploying frontend separately (e.g. Vercel, Netlify):
VITE_API_URL=https://your-backend-service-url.run.app

# Optional WebSocket connection URL for real-time speech / streaming (defaults to ws://)
VITE_WS_URL=wss://your-backend-service-url.run.app

# Optional Supabase Authentication / Database config (if enabled for user auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
